create database pizza_sales_db

use pizza_sales_db

select * from pizza_sales1;

update pizza_sales1
set pizza_size = 
case 
   when pizza_size = 'S' then 'small'
   when pizza_size = 'M' then 'medium'
   when pizza_size = 'L' then 'large'
   when pizza_size = 'XL' then 'extra large'
   when pizza_size = 'XXL' then 'double large'
end;

-- Level 1 – Basic KPIs
-- 1. Find the total revenue from pizza sales.
select sum(total_price) as total_revenue from pizza_sales1
--2. Calculate the average order value.
select (sum(total_price)/ count(order_id)) as avg_order_value from pizza_sales1
--3. Find the total number of pizzas sold.
select count(pizza_id) as total_number_sold from pizza_sales1
-- 4.Count the total number of distinct orders.
select count(distinct order_id) as total_number_sold from pizza_sales1
-- 5. Calculate the average number of pizzas per order.
select (sum(quantity)/ count(distinct order_id)) as avg_order_value from pizza_sales1

-- Level 2 – Date Analysis

-- 6. Find the total orders for each day of the week.
select format(order_date, 'dddd') as order_date,
count( distinct order_id ) as total_orders
from pizza_sales1
group by format(order_date, 'dddd')

--7. Find the total orders for each month.
select format(order_date, 'MMMM') as order_month,
count(distinct order_id) as total_order
from pizza_sales1 
group by format(order_date, 'MMMM')

--8. Find the total revenue for each month.
select format(order_date, 'MMMM') as order_month,
round(sum(total_price),2) as total_revenue
from pizza_sales1
group by format(order_date, 'MMMM')  

--9. Find the total pizzas sold in February.
select sum(quantity) as total_pizza
from pizza_sales1
where month(order_date) = 2
--10. Find the total orders placed on each date.
SELECT
    FORMAT(order_date, 'dd-MM-yyyy') AS Order_Date,
    COUNT(DISTINCT order_id) AS Total_Orders
FROM pizza_sales1
GROUP BY FORMAT(order_date, 'dd-MM-yyyy')
ORDER BY FORMAT(order_date, 'dd-MM-yyyy');
--Level 3 – Category and Size Analysis
--11. Find the total revenue generated by each pizza category.
select pizza_category, sum(total_price) as total_revenue 
from pizza_sales1
group by pizza_category
--12. Calculate the percentage of total sales contributed by each pizza category.
SELECT
    pizza_category,
    SUM(total_price) AS Total_Revenue,
    ROUND(
        SUM(total_price) * 100.0 /
        (SELECT SUM(total_price) FROM pizza_sales1), 2
    ) AS Sales_Percentage
FROM pizza_sales1
GROUP BY pizza_category;
--13. Find the total revenue generated by each pizza size.
select pizza_size, round(sum(total_price),2)
from pizza_sales1
group by pizza_size
--14. Calculate the percentage of sales contributed by each pizza size.
SELECT
    pizza_size,
    SUM(total_price) AS Total_Revenue,
    ROUND(
        SUM(total_price) * 100.0 /
        (SELECT SUM(total_price) FROM pizza_sales1), 2
    ) AS Sales_Percentage
FROM pizza_sales1
GROUP BY pizza_size
ORDER BY pizza_size;
--15. Find the total quantity of pizzas sold by each category in February.
select pizza_category, sum(quantity) as total_quantity 
from pizza_sales1
where month(order_date) = 2
group by pizza_category 

--Level 4 – Ranking Analysis
--16. Find the top 5 pizzas based on revenue.
select top 5 pizza_name, sum(total_price) as total_revenue
from pizza_sales1
group by pizza_name
--17. Find the bottom 5 pizzas based on revenue.
select top 5 pizza_name, sum(total_price) as total_revenue
from pizza_sales1
group by pizza_name
order by total_revenue asc 
--18. Find the top 5 pizzas based on quantity sold.
select top 5 pizza_name, sum(quantity) as quantity_sold from 
pizza_sales1
group by pizza_name 
--19. Find the bottom 5 pizzas based on quantity sold.
select top 5 pizza_name, sum(quantity) as quantity_sold from 
pizza_sales1
group by pizza_name 
order by quantity_sold asc
--20. Find the top 5 pizzas based on the number of orders.
select top 5 pizza_name, count(distinct order_id) as total_no_orders from 
pizza_sales1
group by pizza_name 
--21. Find the bottom 5 pizzas based on the number of orders.
select top 5 pizza_name, count(distinct order_id) as total_orders
from pizza_sales1
group by pizza_names
--Level 5 – Filtering Practice
--22. Find the top 5 pizzas by revenue in the Classic category.
select top 5 pizza_name, sum(total_price) 
from pizza_sales1 
where pizza_category = "Classic"
group by pizza_name
--23. Find the total revenue generated by Large pizzas.
select sum(total_price) as total_revenue,
from pizza_sales1
where pizza_size = "Large"
--24. Find the total orders for the Supreme category.
select count(distinct order_id) as total_orders 
from pizza_sales1
where pizza_category = "Supreme"
--25. Find the top 3 pizzas by quantity sold in February.
select top 3 pizza_name, sum(quantity) as sold_quantity
from pizza_sales1
where month(order_date) = 2
--26. Find the revenue generated by each pizza category for February.
select pizza_category, sum(total_price) as revenue_generated
from pizza_sales1
where month(order_date) = 2
group by pizza_category 
--27. Find pizzas whose total revenue is greater than ₹50,000.
select pizza_name, sum(total_price) as total_revenue
from pizza_sales1
group by pizza_name
having sum(total_price) > 50000
